# Copy to .env.local (for local builds) or set these in your hosting provider's build settings.
# Both come from Supabase → Project Settings → API. The anon/publishable key is safe to expose;
# row-level security in supabase/schema.sql protects the data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
